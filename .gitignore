__pycache__/
*.pyc
*.pyo
.venv/

# local session helper
session

# throwaway clone for local runs
feetbrowser-run/

# user-installed toes are never committed
toes/*
!toes/README.md

# per-toe persisted settings
toes/*/settings.json

# The two Fortran decoders, when they have been built for shipping. The
# packaging puts them here; they are build products, they are platform-
# specific, and each is named after a hash of fortran/ so a committed one
# would go stale silently.
feetbrowser/_h264_*
feetbrowser/_aac_*

# screenshots written by the CI end-to-end check
blank.png
shot.png
