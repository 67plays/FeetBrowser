__pycache__/
*.pyc
*.pyo
.venv/

# local session helper
session

# throwaway clone for local runs
feetbrowser-run/

# user-installed toes are never committed
toes/*
!toes/README.md

# per-toe persisted settings
toes/*/settings.json

# the H.264 decoder, when it has been built for shipping. The packaging puts
# one here; it is a build product, it is platform-specific, and it is named
# after a hash of fortran/ so a committed one would go stale silently.
feetbrowser/_h264_*

